# 复制成 .env 后按需修改；docker-compose.yml 里的 ${VAR:-默认值} 会读这里
#
# 典型场景：本机已经装了 MySQL/Redis/RabbitMQ 占着默认端口，
# 直接改下面的映射端口即可，不用去停本机服务。

# --- 宿主机端口映射 ---
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
APP_PORT=8080

# --- 账号密码 ---
MYSQL_ROOT_PASSWORD=123456
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=123456

# --- 阿里云短信（默认关闭，启用时填写） ---
ALIYUN_ENABLED=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
